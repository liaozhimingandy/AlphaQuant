{
  "_note": "维护任务计划（面板『运行时 → 维护计划』写入，保存即生效）",
  "jobs": {
    "log_cleanup": {
      "task_type": "maintenance.log_cleanup",
      "label": "日志清理",
      "enabled": true,
      "schedule": "daily",
      "at": "03:10",
      "weekday": 1,
      "day_of_month": 1,
      "interval_hours": 24,
      "interval_minutes": 0,
      "trading_hours_only": false,
      "cron": "",
      "once_at": "",
      "params": {
        "apply": false,
        "retention_hours": 168
      },
      "description": "扫描并清理超过保留天数的日志文件；未勾选『真的删除』时只列出清单",
      "custom": false
    },
    "archive": {
      "task_type": "maintenance.archive",
      "label": "快照归档",
      "enabled": false,
      "schedule": "daily",
      "at": "03:40",
      "weekday": 1,
      "day_of_month": 1,
      "interval_hours": 24,
      "interval_minutes": 0,
      "trading_hours_only": false,
      "cron": "",
      "once_at": "",
      "params": {
        "apply": false,
        "before_hours": 720
      },
      "description": "把超过天数的运行快照移入 archive/；默认关闭，需先确认归档目标",
      "custom": false
    },
    "validate": {
      "task_type": "maintenance.validate",
      "label": "运行校验",
      "enabled": true,
      "schedule": "startup",
      "at": "03:10",
      "weekday": 1,
      "day_of_month": 1,
      "interval_hours": 1,
      "interval_minutes": 0,
      "trading_hours_only": false,
      "cron": "",
      "once_at": "",
      "params": {},
      "description": "引擎启动时校验日志目录、数据目录与数据库可用性（只读，不删任何东西）",
      "custom": false
    },
    "dead_history": {
      "task_type": "maintenance.dead_history",
      "label": "死信历史清理",
      "enabled": true,
      "schedule": "daily",
      "at": "04:10",
      "weekday": 1,
      "day_of_month": 1,
      "interval_hours": 24,
      "interval_minutes": 0,
      "trading_hours_only": false,
      "cron": "",
      "once_at": "",
      "params": {
        "keep": "200",
        "apply": true,
        "retention_hours": 720
      },
      "description": "清理已处置超过保留期的死信处置历史（未处置的不动）；对照 Rhapsody 的通知事件历史清理",
      "custom": false
    },
    "kline_intraday": {
      "task_type": "market.kline.intraday",
      "label": "盘中K线刷新",
      "enabled": true,
      "schedule": "interval",
      "at": "03:10",
      "weekday": 1,
      "day_of_month": 1,
      "interval_hours": 24,
      "interval_minutes": 15,
      "trading_hours_only": true,
      "cron": "",
      "once_at": "",
      "params": {
        "source": "flow",
        "limit": 30,
        "lookback_days": 10
      },
      "description": "交易时段每 15 分钟刷新一次候选池标的的日线近况，让策略看到的价格不至于停留在开盘那一根",
      "custom": false
    },
    "kline_post_close": {
      "task_type": "market.kline.post_close",
      "label": "盘后K线同步",
      "enabled": true,
      "schedule": "daily",
      "at": "17:30",
      "weekday": 1,
      "day_of_month": 1,
      "interval_hours": 24,
      "interval_minutes": 0,
      "trading_hours_only": false,
      "cron": "",
      "once_at": "",
      "params": {
        "limit": 0,
        "lookback_days": 30
      },
      "description": "收盘后补齐当天K线：先查谁还缺当天的数据，只补缺的那些",
      "custom": false
    },
    "kline_gap_scan": {
      "task_type": "market.kline.gap_scan",
      "label": "K线缺口体检",
      "enabled": true,
      "schedule": "daily",
      "at": "05:30",
      "weekday": 1,
      "day_of_month": 1,
      "interval_hours": 24,
      "interval_minutes": 0,
      "trading_hours_only": false,
      "cron": "",
      "once_at": "",
      "params": {
        "use_pool": false,
        "lookback_days": 120,
        "auto_repair": true,
        "max_symbols": 200,
        "max_repair": 30
      },
      "description": "扫描“应有却没有”的交易日数据并自动补全；刻意排在清晨，不与盘中任务抢网络额度",
      "custom": false
    },
    "stock_profile": {
      "task_type": "stock.profile.sync",
      "label": "标的主表同步",
      "enabled": true,
      "schedule": "daily",
      "at": "08:30",
      "weekday": 1,
      "day_of_month": 1,
      "interval_hours": 24,
      "interval_minutes": 0,
      "trading_hours_only": false,
      "cron": "",
      "once_at": "",
      "params": {
        "individual_limit": 50
      },
      "description": "同步全市场股票列表与上市日期，它是K线任务跳过未上市/已退市标的的唯一依据",
      "custom": false
    },
    "account_settle": {
      "task_type": "account.settle",
      "label": "账户收盘清算",
      "enabled": true,
      "schedule": "daily",
      "at": "18:00",
      "weekday": 1,
      "day_of_month": 1,
      "interval_hours": 24,
      "interval_minutes": 0,
      "trading_hours_only": false,
      "cron": "",
      "once_at": "",
      "params": {},
      "description": "收盘后把资金/持仓市值/峰值权益固化进账户表（回撤类风控规则跨进程依赖它）",
      "custom": false
    },
    "pool_refresh": {
      "task_type": "pool.refresh",
      "label": "候选股票池刷新",
      "enabled": true,
      "schedule": "interval",
      "at": "03:10",
      "weekday": 1,
      "day_of_month": 1,
      "interval_hours": 24,
      "interval_minutes": 10,
      "trading_hours_only": true,
      "cron": "",
      "once_at": "",
      "params": {
        "source": "flow",
        "limit": 30,
        "sync": false
      },
      "description": "每 10 分钟刷新一次候选股票池（资金流排行取前 30 只打分）。仅在交易时段执行——休市刷出的排名没有意义，还会平白消耗数据源的请求额度。",
      "custom": true
    }
  }
}
